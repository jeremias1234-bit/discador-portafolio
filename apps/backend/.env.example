PUERTO_API=3000

DATABASE_URL=postgres://discador:discador_dev@localhost:5432/discador
REDIS_URL=redis://localhost:6379

# Debe coincidir con asterisk/ari.conf
ARI_URL=http://localhost:8088
ARI_USUARIO=discador
ARI_PASSWORD=CAMBIAR_PASSWORD_ARI
ARI_APP=discador

# Sesiones del panel. En producción (HTTPS con la CA propia) COOKIE_SEGURA=true
SESION_HORAS=12
COOKIE_SEGURA=false

# Audios de campañas (lo escribe el backend, lo lee Asterisk)
DIR_AUDIOS=/var/lib/asterisk/sounds/campanas

# Archivo de PJSIP que genera el backend (gateways e internos), incluido desde pjsip.conf
ARCHIVO_PJSIP=/etc/asterisk/pjsip_discador.conf

# Grabaciones: las escribe Asterisk; el backend mide el espacio libre (se sirven y borran por ARI)
DIR_GRABACIONES=/var/spool/asterisk/recording
