# Copiar a .env en la raíz del repo y completar. Nunca se sube al repo (.env está en .gitignore).
#   cp docker/env.produccion.ejemplo .env
# Docker Compose lo lee solo: con COMPOSE_FILE alcanza con "docker compose up -d", "docker compose ps", etc.
# Claves: solo letras y números. Para generarlas: openssl rand -hex 16

COMPOSE_FILE=compose.produccion.yml

POSTGRES_PASSWORD=CAMBIAR_CLAVE_POSTGRES
ARI_PASSWORD=CAMBIAR_CLAVE_ARI

TZ=America/Argentina/Buenos_Aires
SESION_HORAS=12

# Solo si esos puertos ya están ocupados en la máquina
PUERTO_POSTGRES=5432
PUERTO_REDIS=6379
# SIP de los Dinstar (el Remote Port de su SIP Trunk tiene que ser este) y rango UDP del audio
PUERTO_SIP=5060
RTP_INICIO=10000
RTP_FIN=20000
# HTTP de Asterisk para ARI (solo 127.0.0.1). El servicio de red usa el 8088 (y el 27001 y
# 29810-29817 por UDP: que no caigan dentro del rango del audio)
PUERTO_ARI=8088
